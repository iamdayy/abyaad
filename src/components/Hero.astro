---
import { CldImage } from "astro-cloudinary";
import heroData from "../data/hero.json";

type HeroContent = {
  badge: string; titleLead: string; titleAccent: string; description: string;
  ctaLabel: string; ctaTarget: string; secondaryCtaLabel: string; secondaryCtaTarget: string;
  featuredLabel: string; featuredTitle: string; featuredDescription: string; cloudinaryPublicId: string;
};
const hero = heroData as unknown as HeroContent;
---

<section class="section-shell grid gap-10 pb-16 pt-12 sm:pt-16 md:grid-cols-[0.85fr_1.15fr] md:items-center md:gap-14 md:pb-24 md:pt-20">
  <div class="order-2 md:order-1">
    <p class="eyebrow">{hero.badge}</p>
    <h1 class="mt-6 max-w-xl text-5xl leading-[0.96] text-abyaad-ink sm:text-6xl lg:text-7xl">
      {hero.titleLead}<span class="block text-abyaad-navy italic">{hero.titleAccent}</span>
    </h1>
    <p class="mt-6 max-w-lg text-sm leading-7 text-slate-600 sm:text-base">{hero.description}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={hero.ctaTarget} class="inline-flex items-center rounded-full bg-abyaad-navy px-6 py-3 text-[0.68rem] font-medium uppercase tracking-[0.2em] text-white hover:-translate-y-0.5 hover:bg-abyaad-ink" data-cta="hero-primary">{hero.ctaLabel}</a>
      <a href={hero.secondaryCtaTarget} class="inline-flex items-center rounded-full border border-abyaad-line bg-white px-6 py-3 text-[0.68rem] font-medium uppercase tracking-[0.2em] text-abyaad-ink hover:border-abyaad-navy" data-cta="hero-secondary">{hero.secondaryCtaLabel}</a>
    </div>
    <div class="mt-12 flex gap-8 border-t border-abyaad-line pt-5 text-[0.62rem] uppercase tracking-[0.2em] text-slate-500">
      <span>Made in Pekalongan</span><span>Organic fiber</span>
    </div>
  </div>

  <div id="lookbook" class="group relative order-1 min-h-[28rem] overflow-hidden bg-abyaad-blue md:order-2 md:min-h-[38rem]">
    <CldImage src={hero.cloudinaryPublicId} alt="Editorial lookbook preview for Abyaad essentials" width={1300} height={1600} crop="fill" gravity="auto" quality="auto" format="auto" class="h-full min-h-[28rem] w-full object-cover transition duration-700 group-hover:scale-[1.03] md:min-h-[38rem]" loading="eager" decoding="async" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-abyaad-ink/60 via-transparent to-transparent"></div>
    <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between gap-4 text-white">
      <div><p class="text-[0.62rem] uppercase tracking-[0.24em] text-white/70">{hero.featuredLabel}</p><h2 class="mt-2 text-2xl leading-tight">{hero.featuredTitle}</h2></div>
      <p class="hidden max-w-[13rem] text-xs leading-relaxed text-white/80 sm:block">{hero.featuredDescription}</p>
    </div>
  </div>
</section>
